{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true
  },
  // `vitest.setup.ts` is in here on purpose: its `import
  // '@testing-library/jest-dom'` is a module augmentation, and an augmentation
  // only applies to files in the same compilation. Left out, every jest-dom
  // matcher in a test is an untyped property access — which is exactly how
  // seven of them went unnoticed until the tests entered the project.
  "include": ["src/**/*", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
