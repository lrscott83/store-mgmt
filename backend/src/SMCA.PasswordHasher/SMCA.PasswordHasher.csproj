<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

  <!--
    The API's config files are linked rather than duplicated, so this tool always hashes with
    the same settings the running API uses. appsettings.Production.json is gitignored and only
    exists on the VPS, hence the Exists() condition.
  -->
  <ItemGroup>
    <None Include="..\SMCA.WebApi\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SMCA.WebApi\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SMCA.WebApi\appsettings.Production.json" Link="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\SMCA.WebApi\appsettings.Production.json')" />
  </ItemGroup>

</Project>
