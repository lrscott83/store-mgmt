{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "Vende De Todo",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.png", "/index.csr.html", "/index.html", "/assets/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-freshness",
      "urls": ["/api/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "10s"
      }
    },
    {
      "name": "api-performance",
      "urls": ["/api/v1/categories/**", "/api/v1/products/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "7d"
      }
    },
    {
      "name": "auth-api",
      "urls": ["/api/v1/auth/login", "/api/v1/auth/register"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "30d"
      }
    },
    {
      "name": "static-assets",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**", "https://cdn.jsdelivr.net/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "30d"
      }
    }
  ]
}
